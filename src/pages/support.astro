---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LetterCollage from "../assets/images/letter-collage.png";
import BarbsLogo from "../assets/images/barbs-butchery.webp";
import SweetEsLogo from "../assets/images/sweet-es.webp";
import DreamingGoddessLogo from "../assets/images/dreaming-goddess.webp";

const businesses = [
  {
    id: "barbs",
    name: "Barb's Butchery",
    logo: BarbsLogo,
    location: "69 Spring Street, Beacon, NY",
    description:
      "An animal butcher shop providing locally sourced, grass-fed, and pasture-raised meats from small Hudson Valley farms. Alongside custom cuts, daily ground burgers, and wild-card house sausages; the shop features a hot food breakfast and lunch counter alongside handmade tallow skincare goods.",
  },
  {
    id: "sweet-es",
    name: "Sweet E's",
    logo: SweetEsLogo,
    location: "3091 Route 9, Cold Spring, NY (inside Vera's Marketplace)",
    description:
      "A local destination for sweet treats and comfort food favorites, offering custom ice cream sandwiches, ice cream pies, and specialty pints. Operating out of Vera's Marketplace plaza, they also coordinate seasonal holiday pie pre-orders and custom party dessert packages.",
  },
  {
    id: "dreaming-goddess",
    name: "Dreaming Goddess",
    logo: DreamingGoddessLogo,
    location: "44 Raymond Ave, Poughkeepsie, NY",
    description:
      "A long-standing specialty and metaphysical shop offering crystals, gemstones, tarot decks, ritual kits, herbs, and unique spiritual wellness tools. Dedicated to healing and empowerment, it also provides an extensive online crystal resource library, custom readings, and community events.",
  },
];
---

<Layout title="Support — Bodily Sovereignty">
  <Header />

  <main
    class="support-page"
    style={`--collage-url: url("${LetterCollage.src}");`}
  >
    <div class="support-overlay">
      <header class="support-header">
        <h1 class="support-title">Support</h1>
      </header>

      <div class="support-divider" aria-hidden="true"></div>

      <section class="support-grid">
        <div class="support-lead">
          <p>Female owned<br />businesses in the<br />Hudson Valley:</p>
        </div>

        <div class="support-cards">
          {businesses.map((biz) => (
            <button
              type="button"
              class="support-card"
              data-modal-target={`modal-${biz.id}`}
              aria-haspopup="dialog"
              aria-controls={`modal-${biz.id}`}
            >
              <img
                src={biz.logo.src}
                alt={`${biz.name} logo`}
                class="support-logo"
                loading="eager"
              />
            </button>
          ))}
        </div>
      </section>
    </div>

    <!-- Popup Modals -->
    {businesses.map((biz) => (
      <dialog
        id={`modal-${biz.id}`}
        class="popup-dialog"
        aria-label={biz.name}
      >
        <div class="popup-card">
          <button
            type="button"
            class="popup-close"
            aria-label={`Close ${biz.name} popup`}
          >
            &#10006;
          </button>

          <div class="popup-body">
            <p class="popup-heading">{biz.name}</p>
            <p>
              <strong>Location:</strong> {biz.location}
            </p>
            <p>
              <strong>Description:</strong> {biz.description}
            </p>
          </div>
        </div>
      </dialog>
    ))}
  </main>

  <Footer />
</Layout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-modal-target]");
  const dialogs = document.querySelectorAll<HTMLDialogElement>("dialog.popup-dialog");

  triggers.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-modal-target");
      if (!targetId) return;
      const dialog = document.getElementById(targetId) as HTMLDialogElement | null;
      if (dialog && typeof dialog.showModal === "function") {
        dialog.showModal();
      }
    });
  });

  dialogs.forEach((dialog) => {
    const closeBtn = dialog.querySelector<HTMLButtonElement>(".popup-close");

    closeBtn?.addEventListener("click", () => {
      dialog.close();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  });
</script>

<style is:global>
  :root {
    --plum-dark: #381028;
    --plum-ink: #2b0917;
    --black-bg: #050505;
    --sage-bg: #466346;
    --olive-bg: #6a7b33;
    --off-white: #ecefe9;
    --neon-green: #00ff1a;

    --font-gothic: "Manufacturing Consent", serif;
    --font-serif: "Libre Baskerville", serif;
    --font-sans: "DM Sans", sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--black-bg);
    color: var(--off-white);
    font-family: var(--font-sans);
  }

  body {
    margin: 0;
    overflow-x: hidden;
  }

  header,
  footer {
    background-color: var(--plum-dark);
    color: var(--off-white);
    width: 100%;
  }

  .support-page {
    position: relative;
    background-color: var(--black-bg);
    min-height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  .support-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--plum-dark);
    background-image: var(--collage-url);
    background-repeat: no-repeat;
    background-position: left center;
    background-size: cover;
    background-blend-mode: multiply;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .support-overlay {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .support-header {
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem clamp(2rem, 4.5vw, 3.25rem);
    text-align: center;
  }

  .support-title {
    font-family: var(--font-gothic);
    font-size: clamp(3.2rem, 6.5vw, 5.2rem);
    font-weight: 400;
    line-height: 1;
    color: #ffffff;
  }

  .support-divider {
    width: 100%;
    border-top: 6px dashed var(--neon-green);
  }

  .support-grid {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 6vw, 4rem)
      clamp(4rem, 8vw, 6rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    justify-items: center;
    gap: clamp(2rem, 6vw, 4.5rem);
  }

  .support-lead {
    width: 100%;
    max-width: 320px;
    padding-top: clamp(1rem, 3vw, 2.5rem);
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.22;
    color: #ffffff;
  }

  .support-cards {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4.5vw, 3.25rem);
    align-items: center;
  }

  .support-card {
    position: relative;
    width: min(100%, 380px);
    aspect-ratio: 1 / 1;
    background-color: var(--olive-bg);
    border: 2px solid transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.22s ease,
      box-shadow 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.22s ease;
  }

  .support-logo {
    max-width: 82%;
    max-height: 82%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    pointer-events: none;
  }

  .support-card:hover,
  .support-card:focus-visible {
    background-color: var(--sage-bg);
    border-color: var(--neon-green);
    transform: translate(-6px, -6px);
    box-shadow: 10px 10px 0px var(--plum-dark);
    outline: none;
  }

  .support-card:active {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px var(--plum-dark);
  }

  /* Popup Dialog Styling */
  .popup-dialog {
    margin: auto;
    border: none;
    background: transparent;
    padding: 1.25rem;
    max-width: min(92vw, 460px);
    width: 100%;
    overflow: visible;
  }

  .popup-dialog::backdrop {
    background-color: rgba(5, 5, 5, 0.72);
    backdrop-filter: blur(2px);
  }

  .popup-card {
    position: relative;
    background-color: var(--sage-bg);
    color: var(--off-white);
    padding: 2.75rem 2.25rem 2.25rem;
    width: 100%;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.55);
  }

  .popup-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2rem;
    height: 2rem;
    border: none;
    background: transparent;
    color: #090c06;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .popup-close:hover {
    transform: scale(1.12);
    opacity: 0.75;
  }

  .popup-body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.48;
    color: #f3f5ef;
  }

  .popup-heading {
    font-weight: 700;
    font-size: 1rem;
  }

  @media (max-width: 820px) {
    .support-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .support-lead {
      padding-top: 0;
    }

    .support-card {
      width: min(100%, 340px);
    }

    .popup-card {
      padding: 2.75rem 1.5rem 1.75rem;
    }
  }
</style>